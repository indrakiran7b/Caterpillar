# Copy to .env.local for local development.
# Do not put real credentials in this file or in git.

# --------------------------------------------------
# PUBLIC CONFIGURATION
# Safe to expose to the browser. Visible in the client bundle.
# --------------------------------------------------

# Canonical production origin, including https. Example: https://www.example.in
# Leave empty locally. Set this in Vercel after the custom domain is connected.
NEXT_PUBLIC_SITE_URL=

# Optional. If set, all Book a pickup CTAs go here instead of /book.
NEXT_PUBLIC_BOOKING_URL=

# Public API origin for the CaterPillar backend.
# Leave empty until that backend exists. Do not use localhost or private-network addresses in production.
NEXT_PUBLIC_API_URL=

# Optional paths appended to NEXT_PUBLIC_API_URL.
# Leave empty until the backend documents these routes.
NEXT_PUBLIC_MATERIALS_PATH=
NEXT_PUBLIC_PICKUPS_PATH=
NEXT_PUBLIC_SERVICEABILITY_PATH=

# Deprecated alias. Prefer NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_PICKUP_API_URL=

# Production store URLs. Leave empty to show Coming soon.
NEXT_PUBLIC_ANDROID_APP_URL=
NEXT_PUBLIC_IOS_APP_URL=

# --------------------------------------------------
# DEVELOPMENT ONLY
# Ignored in production builds. Do not enable on Vercel.
# --------------------------------------------------

# Set to true in .env.local to simulate materials, serviceability, and pickup responses.
NEXT_PUBLIC_USE_MOCK_API=

# --------------------------------------------------
# SERVER-ONLY SECRETS
# None are used by this website today.
# If a backend later needs a private key, add it here without the NEXT_PUBLIC_ prefix
# and never send it to the browser.
# --------------------------------------------------
